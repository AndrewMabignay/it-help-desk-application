@model ITHelpDeskApplication.ViewModels.EditTicketViewModel

@{
    ViewData["Title"] = "Ticket Updated";
}

<div class="container-fluid">
    <div class="card border-0 shadow-sm">
        <div class="card-body p-5 text-center">

            <h2 class="text-success mb-3">
                Ticket Updated Successfully!
            </h2>

            <p class="text-muted">
                The submitted changes are displayed below.
            </p>

            <hr />

            <div class="text-start mx-auto" style="max-width: 600px;">
                <p><strong>Ticket ID:</strong> #@Model.Id</p>
                <p><strong>Subject:</strong> @Model.Subject</p>
                <p><strong>Requester:</strong> @Model.Requester</p>
                <p><strong>Department:</strong> @Model.Department</p>
                <p><strong>Category:</strong> @Model.Category</p>
                <p><strong>Priority:</strong> @Model.Priority</p>
                <p><strong>Status:</strong> @Model.Status</p>
                <p><strong>Description:</strong> @Model.Description</p>
            </div>

            <a asp-controller="TicketsMvc"
               asp-action="Index"
               class="btn btn-primary mt-3">
                Back to Tickets
            </a>

        </div>
    </div>
</div>