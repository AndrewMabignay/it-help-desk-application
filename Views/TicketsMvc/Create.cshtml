@model ITHelpDeskApplication.ViewModels.CreateTicketViewModel

@{
    ViewData["Title"] = "Create Ticket";
}

<div class="container-fluid">
    <div class="mb-4">
        <h2>Create New Ticket</h2>
        <p class="text-muted">Fill out the information below.</p>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">

            <form asp-controller="TicketsMvc"
                  asp-action="Create"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Subject" class="form-label"></label>
                    <input asp-for="Subject" class="form-control"
                           placeholder="Enter ticket subject" />
                    <span asp-validation-for="Subject"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description"
                              class="form-control"
                              rows="4"
                              placeholder="Describe the issue"></textarea>
                    <span asp-validation-for="Description"
                          class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Requester" class="form-label"></label>
                        <input asp-for="Requester" class="form-control"
                               placeholder="Enter requester name" />
                        <span asp-validation-for="Requester"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="RequesterEmail" class="form-label"></label>
                        <input asp-for="RequesterEmail" class="form-control"
                               placeholder="example@email.com" />
                        <span asp-validation-for="RequesterEmail"
                              class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Department" class="form-label"></label>
                        <select asp-for="Department" class="form-select">
                            <option value="">Select Department</option>
                            <option>IT Department</option>
                            <option>Human Resources</option>
                            <option>Finance</option>
                            <option>Marketing</option>
                            <option>Operations</option>
                        </select>
                        <span asp-validation-for="Department"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Category" class="form-label"></label>
                        <select asp-for="Category" class="form-select">
                            <option value="">Select Category</option>
                            <option>Hardware</option>
                            <option>Software</option>
                            <option>Network</option>
                            <option>Account Issues</option>
                            <option>Other</option>
                        </select>
                        <span asp-validation-for="Category"
                              class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Priority" class="form-label"></label>
                    <select asp-for="Priority" class="form-select">
                        <option value="">Select Priority</option>
                        <option>Low</option>
                        <option>Medium</option>
                        <option>High</option>
                        <option>Critical</option>
                    </select>
                    <span asp-validation-for="Priority"
                          class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        Submit Ticket
                    </button>

                    <a asp-controller="TicketsMvc"
                       asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>
                </div>

            </form>
        </div>
    </div>
</div>