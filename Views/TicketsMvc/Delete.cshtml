@model ITHelpDeskApplication.ViewModels.TicketViewModel

@{
    ViewData["Title"] = "Delete Ticket";
}

<div class="container-fluid">
    <div class="card border-0 shadow-sm">
        <div class="card-body p-5">

            <h2 class="text-danger">Delete Ticket</h2>

            <p class="text-muted">
                Are you sure you want to delete this ticket?
            </p>

            <hr />

            <p><strong>Ticket ID:</strong> #@Model.Id</p>
            <p><strong>Subject:</strong> @Model.Subject</p>
            <p><strong>Requester:</strong> @Model.Requester</p>
            <p><strong>Priority:</strong> @Model.Priority</p>
            <p><strong>Status:</strong> @Model.Status</p>

            <form asp-controller="TicketsMvc"
                  asp-action="Delete"
                  asp-route-id="@Model.Id"
                  method="post">

                <button type="submit" class="btn btn-danger">
                    Confirm Delete
                </button>

                <a asp-controller="TicketsMvc"
                   asp-action="Index"
                   class="btn btn-outline-secondary">
                    Cancel
                </a>
            </form>

        </div>
    </div>
</div>