@model List<ITHelpDeskApplication.ViewModels.TicketAttachmentViewModel>

@{
    ViewData["Title"] = "Ticket Attachments";
}

<div class="container-fluid">

    <div class="mb-4 d-flex justify-content-between align-items-center">
        <div>
            <h2>Ticket Attachments</h2>
            <p class="text-muted">
                Ticket #@ViewBag.TicketId - @ViewBag.Subject
            </p>
        </div>

        <a asp-controller="TicketsMvc"
           asp-action="UploadAttachment"
           asp-route-id="@ViewBag.TicketId"
           class="btn btn-primary">
            Upload Attachment
        </a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body">

            <div class="table-responsive">
                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>File Name</th>
                            <th>Uploaded By</th>
                            <th>Uploaded At</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var attachment in Model)
                        {
                            <tr>
                                <td>@attachment.FileName</td>
                                <td>@attachment.UploadedBy</td>
                                <td>
                                    @attachment.UploadedAt.ToString("MMM dd, yyyy")
                                </td>
                                <td>
                                    <span class="text-muted">
                                        Sample Attachment
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

        </div>
    </div>

    <a asp-controller="TicketsMvc"
       asp-action="Index"
       class="btn btn-outline-secondary mt-3">
        Back to Tickets
    </a>

</div>
