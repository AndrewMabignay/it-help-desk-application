@model ITHelpDeskApplication.ViewModels.UploadTicketAttachmentViewModel

@{
    ViewData["Title"] = "Upload Attachment";
}

<div class="container-fluid">

    <div class="mb-4">
        <h2>Upload Attachment</h2>
        <p class="text-muted">
            Attach a file to Ticket #@Model.TicketId.
        </p>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">

            <form asp-controller="TicketsMvc"
                  asp-action="UploadAttachment"
                  method="post"
                  enctype="multipart/form-data">

                <input type="hidden" asp-for="TicketId" />

                <div asp-validation-summary="All"
                     class="text-danger mb-3"></div>

                <div class="mb-4">
                    <label asp-for="File" class="form-label">
                        Select File
                    </label>

                    <input asp-for="File"
                           type="file"
                           class="form-control"
                           accept=".pdf,.png,.jpg,.jpeg,.doc,.docx,.xls,.xlsx,.txt" />

                    <small class="text-muted">
                        Allowed: PDF, PNG, JPG, DOC, DOCX, XLS, XLSX, TXT.
                        Maximum size: 5 MB.
                    </small>

                    <span asp-validation-for="File"
                          class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">
                    Upload File
                </button>

                <a asp-controller="TicketsMvc"
                   asp-action="Attachments"
                   asp-route-id="@Model.TicketId"
                   class="btn btn-outline-secondary">
                    Cancel
                </a>

            </form>

        </div>
    </div>

</div>
