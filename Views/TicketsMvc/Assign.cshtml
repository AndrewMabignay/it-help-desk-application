@model ITHelpDeskApplication.ViewModels.TicketAssignmentViewModel

@{
    ViewData["Title"] = "Assign Ticket";
}

<div class="container-fluid">

    <div class="mb-4">
        <h2>Assign Ticket</h2>
        <p class="text-muted">
            Assign this support ticket to an IT staff member.
        </p>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">

            <div class="mb-4">
                <p>
                    <strong>Ticket ID:</strong> #@Model.TicketId
                </p>

                <p>
                    <strong>Subject:</strong> @Model.TicketSubject
                </p>
            </div>

            <hr />

            <form asp-controller="TicketsMvc"
                  asp-action="Assign"
                  asp-route-id="@Model.TicketId"
                  method="post">

                <input type="hidden" asp-for="TicketId" />
                <input type="hidden" asp-for="TicketSubject" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-4">
                    <label asp-for="AssignedTo"
                           class="form-label">
                        Assign To
                    </label>

                    <select asp-for="AssignedTo"
                            class="form-select">

                        <option value="">Select IT Staff</option>

                        @foreach (var staff in ViewBag.StaffList)
                        {
                            <option value="@staff">@staff</option>
                        }

                    </select>

                    <span asp-validation-for="AssignedTo"
                          class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        Assign Ticket
                    </button>

                    <a asp-controller="TicketsMvc"
                       asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>
    </div>

</div>
